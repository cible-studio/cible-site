APP_NAME="CIBLE CI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cible-ci.com
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ────────────────────────────────────────────────────────────
# Cache / Session / Queue — SQLite pour tout (site vitrine sans
# vraie BDD, juste un fichier local pour cache/sessions Laravel).
# Zéro service externe → aucune dépendance runtime.
# ────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ────────────────────────────────────────────────────────────
# Mail — SMTP à configurer selon prestataire (OVH / Google / Brevo…).
# En dev : MAIL_MAILER=log → mails dans storage/logs/laravel.log
# En prod : MAIL_MAILER=smtp + credentials du prestataire.
#
# ⚠ Laravel 11+ lit MAIL_SCHEME, PAS MAIL_ENCRYPTION (cf. config/mail.php).
#   MAIL_ENCRYPTION est ignoré en silence — ne pas le réintroduire.
#     port 587 → MAIL_SCHEME=smtp   (STARTTLS, le cas courant)
#     port 465 → MAIL_SCHEME=smtps  (TLS implicite)
#
# ⚠ Gmail / Google Workspace : le mot de passe du compte est REFUSÉ depuis
#   2022 (« 535-5.7.8 Username and Password not accepted »). Il faut activer
#   la validation en 2 étapes puis générer un mot de passe d'application de
#   16 caractères sur https://myaccount.google.com/apppasswords et le mettre
#   dans MAIL_PASSWORD, sans les espaces. MAIL_USERNAME doit être une vraie
#   boîte, pas un simple alias.
# ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="site@cible-ci.com"
MAIL_FROM_NAME="Site CIBLE"

# Destinataire du formulaire /contact (demandes de devis).
CIBLE_DEVIS_TO=commercial@cible-ci.com

# ────────────────────────────────────────────────────────────
# Google Analytics — ID de mesure (GA4 : G-XXXXXXXXXX).
# Laissé vide en dev pour ne pas polluer les stats.
# ────────────────────────────────────────────────────────────
CIBLE_GA_ID=

VITE_APP_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────
# Cloudflare Turnstile — anti-robot du formulaire /contact.
# Tant que ces deux clés sont vides, le widget n'est pas rendu et la
# vérification laisse passer : le site fonctionne à l'identique.
# Clés à créer sur dash.cloudflare.com → Turnstile (gratuit).
# ────────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ────────────────────────────────────────────────────────────
# Espace d'administration (/admin).
# Tant que ces deux variables sont vides, /admin répond 404 : l'espace
# n'existe pas pour un visiteur. Générer le hash avec :
#     php artisan cible:admin-hash
# ⚠ Prévoir dans Coolify un VOLUME PERSISTANT monté sur
#   /app/storage/app/contenu — sans lui, les modifications faites depuis
#   l'admin disparaissent au redéploiement suivant.
# ────────────────────────────────────────────────────────────
CIBLE_ADMIN_EMAIL=
CIBLE_ADMIN_HASH=
