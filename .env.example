APP_NAME="CIBLE CI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cible-ci.com
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ────────────────────────────────────────────────────────────
# Cache / Session / Queue — SQLite pour tout (site vitrine sans
# vraie BDD, juste un fichier local pour cache/sessions Laravel).
# Zéro service externe → aucune dépendance runtime.
# ────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ────────────────────────────────────────────────────────────
# Mail — SMTP à configurer selon prestataire (OVH / Google / SendGrid).
# En dev : MAIL_MAILER=log → mails dans storage/logs/laravel.log
# En prod : MAIL_MAILER=smtp + credentials du prestataire.
# ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="site@cible-ci.com"
MAIL_FROM_NAME="Site CIBLE"

# Destinataire du formulaire /contact (demandes de devis).
CIBLE_DEVIS_TO=commercial@cible-ci.com

# ────────────────────────────────────────────────────────────
# Google Analytics — ID de mesure (GA4 : G-XXXXXXXXXX).
# Laissé vide en dev pour ne pas polluer les stats.
# ────────────────────────────────────────────────────────────
CIBLE_GA_ID=

VITE_APP_NAME="${APP_NAME}"
